---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro';
const cards=[['Search strategy','Bring focus to the roles, sectors and opportunities you are exploring.'],['Application support','Prepare application materials with a more structured, purposeful approach.'],['Interview preparation','Build confidence for conversations with practical preparation and reflection.']];
---
<BaseLayout title="RAU Job Support" description="RAU Job Support provides practical job-search, application and interview preparation support."><PageHero eyebrow="RAU Job Support" title="A more focused approach to your job search." intro="Practical support for job-search strategy, applications and interview preparation—designed to help you take the next step with confidence." /><section class="section section-soft"><div class="shell"><div class="section-heading"><div><p class="eyebrow">How we can help</p><h2>Turn effort into a clearer process.</h2></div><p>Job searching can feel fragmented. We help organise the work around the decisions and materials that matter most.</p></div><div class="content-grid">{cards.map(([title,text])=><article class="info-card"><h3>{title}</h3><p>{text}</p></article>)}</div></div></section><section class="section"><div class="shell callout"><p class="eyebrow">Get started</p><h2>Ready to bring more structure to your search?</h2><p>Tell us about where you are now and the kind of support you are looking for.</p><a class="button" href="/contact">Contact RAU Global <span aria-hidden="true">→</span></a></div></section></BaseLayout>
