---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro';
const cards=[['Structured modules','A clear learning framework for building German skills progressively.'],['Learning pathways','Guidance to help learners understand their route and stay focused.'],['Exam preparation','Dedicated preparation support for learners preparing for German language examinations.']];
---
<BaseLayout title="RAU Language Academy | German learning" description="RAU Language Academy offers structured German learning pathways and exam preparation."><div class="division-logo"><img src="/assets/logo-rau.png" alt="RAU Global" /></div><PageHero eyebrow="RAU Language Academy" title="German learning with direction." intro="Structured modules, clear learning pathways and focused preparation for learners building their future in German-speaking environments." /><section class="section"><div class="shell"><div class="section-heading"><div><p class="eyebrow">Our approach</p><h2>Learn with structure. Prepare with purpose.</h2></div><p>Our focus is to provide a more organised learning experience—so the next level, milestone or exam feels easier to approach.</p></div><div class="content-grid">{cards.map(([title,text])=><article class="info-card"><h3>{title}</h3><p>{text}</p></article>)}</div></div></section><section class="cta-band"><div class="shell"><p class="eyebrow">Language learning</p><h2>Looking for the right German learning pathway?</h2><p>Contact RAU Global to discuss your learning context and next steps.</p><a class="button" href="/contact">Speak with us <span aria-hidden="true">→</span></a></div></section></BaseLayout>
