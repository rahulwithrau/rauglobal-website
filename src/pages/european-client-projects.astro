---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro';
const cards=[['Project support','A dedicated route for European companies seeking project assistance from an India-based team.'],['Direct communication','A clear point of contact and a practical way to align on project requirements.'],['Flexible delivery','Support shaped around the defined needs and scope of each individual project.']];
---
<BaseLayout title="European Client Projects | RAU Global" description="RAU Global supports European client projects through an India-based delivery team."><div class="division-logo"><img src="/assets/logo-rau.png" alt="RAU Global" /></div><PageHero eyebrow="European Client Projects" title="Project support for European businesses, delivered from India." intro="RAU Global’s business division supports European clients with project work through a dedicated India team." /><section class="section"><div class="shell split"><div class="copy"><h2>A practical Europe–India project relationship.</h2><p>We provide a route for European clients who are looking to engage an India-based team for defined project support.</p><p>Every project starts with a conversation about the work, the required collaboration model and the best way to move forward.</p><a class="text-link" href="/contact">Discuss a project <span aria-hidden="true">→</span></a></div><ul class="feature-list">{cards.map(([title,text])=><li><div><strong>{title}</strong>{text}</div></li>)}</ul></div></section><section class="cta-band"><div class="shell"><p class="eyebrow">For European clients</p><h2>Have a project you would like to discuss?</h2><p>Contact RAU Global with an outline of your needs and we will start the conversation.</p><a class="button" href="/contact">Get in touch <span aria-hidden="true">→</span></a></div></section></BaseLayout>
