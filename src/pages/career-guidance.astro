---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro';
const cards=[['Study pathways','Guidance to help you consider study options and prepare for your next decision in Europe.'],['Vocational pathways','Practical orientation for people exploring vocational training routes across Europe.'],['Career preparation','Support with career planning, CV preparation and interview readiness.']];
---
<BaseLayout title="RAU Career Guidance" description="RAU Career Guidance supports European study, vocational and career preparation pathways."><PageHero eyebrow="RAU Career Guidance" title="Make your next Europe decision with more clarity." intro="Guidance for study and vocational pathways across Europe, alongside practical preparation for the career steps that follow." /><section class="section"><div class="shell split"><div class="copy"><h2>Planning is more useful when it is personal.</h2><p>International education and career decisions involve many moving parts. RAU Career Guidance helps you bring them into a clearer order.</p><p>We focus on practical preparation, so you can move into conversations, applications and interviews with a stronger sense of direction.</p></div><ul class="feature-list">{cards.map(([title,text])=><li><div><strong>{title}</strong>{text}</div></li>)}</ul></div></section><section class="cta-band"><div class="shell"><p class="eyebrow">Plan your route</p><h2>Explore your Europe pathway with RAU Global.</h2><a class="button" href="/contact">Contact us <span aria-hidden="true">→</span></a></div></section></BaseLayout>
