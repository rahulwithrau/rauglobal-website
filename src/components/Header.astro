---
const pathname = Astro.url.pathname;
const links = [{href:'/about',label:'About'},{href:'/language-academy',label:'Language Academy'},{href:'/career-guidance',label:'Career Guidance'},{href:'/job-support',label:'Job Support'},{href:'/european-client-projects',label:'European Projects'}];
---
<header class="site-header"><div class="shell header-inner"><a class="brand brand-lockup" href="/" aria-label="RAU Global home"><img class="logo-mark" src="/assets/logo-rau.png" alt="RAU Global" /></a><details class="mobile-nav"><summary aria-label="Open navigation"><span></span><span></span><span></span></summary><nav aria-label="Mobile navigation">{links.map(link => <a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>{link.label}</a>)}<a href="/contact" class="nav-button">Start a conversation</a></nav></details><nav class="desktop-nav" aria-label="Primary navigation">{links.map(link => <a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>{link.label}</a>)}<a href="/contact" class="nav-button">Contact</a></nav></div></header>
