---
interface Props { number:string; title:string; description:string; href:string; }
const { number, title, description, href } = Astro.props;
---
<article class="division-card"><span class="card-number">{number}</span><h3>{title}</h3><p>{description}</p><a class="text-link" href={href}>Explore this division <span aria-hidden="true">→</span></a></article>
